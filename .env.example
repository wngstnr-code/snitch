# ---- Onchain (CLAUDE.md §4) ----
# 84532 = Base Sepolia (default) | 8453 = Base mainnet (opsional)
CHAIN_ID=84532
# Signer attestation. Buat wallet sendiri: `npm run wallet:new`, lalu ambil ETH
# dari faucet Base Sepolia. JANGAN PERNAH commit nilai aslinya, dan jangan pakai
# key orang lain — satu wallet per orang (B8/R8).
ATTESTER_PRIVATE_KEY=0x
# UID schema SNITCH di Base Sepolia. Bukan rahasia — data publik di chain, dan
# deterministik dari string schema. Biarkan apa adanya kecuali schema berubah.
EAS_SCHEMA_UID=0x9e8b55aca7c009f585ab66efee61cd48edf3167f8e03a858508bd85f1e2c9c25

# ---- Database (Neon) ----
DATABASE_URL=postgres://

# ---- Vercel Blob (evidence bundle) ----
BLOB_READ_WRITE_TOKEN=

# ---- AI Gateway (model string: anthropic/claude-sonnet-5) ----
AI_GATEWAY_API_KEY=
