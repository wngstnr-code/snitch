{
  "name": "snitch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx --test \"lib/**/*.test.ts\"",
    "wallet:new": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/new-wallet.ts",
    "schema:register": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/register-schema.ts",
    "db:generate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/drizzle-kit migrate",
    "db:push": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/drizzle-kit studio",
    "sanctions:sync": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/sync-sanctions.ts",
    "mills:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/seed-mills.ts",
    "services:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/check-services.ts",
    "chain:verify": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/verify-contracts.ts",
    "chain:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/check-chain.ts",
    "db:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.33",
    "@base-ui/react": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "ai": "^7.0.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
